# SonarAIM Client Application Configuration
# Zero-hardcode runtime parameters for Desktop, Mobile, and Instant Web / App Clip targets

# Relay and Federation Endpoints
SONARAIM_RELAY_URL=wss://relay.sonaraim.example.com/v1/mls
SONARAIM_DID_RESOLVER_URL=https://resolver.sonaraim.example.com/1.0/identifiers

# Dual Inbox Configuration
SONARAIM_INBOX_PERSONAL_STREAM=PERSONAL
SONARAIM_INBOX_SERVICES_STREAM=SERVICES
SONARAIM_PEER_DID_PREFIX=did:sonaraim:
SONARAIM_MERCHANT_DID_PREFIX=did:web:
SONARAIM_REQUIRE_CONSENT_FOR_SERVICES=true

# Zero-HTML Declarative Card Policy
SONARAIM_CARD_MAX_COMPONENTS=24
SONARAIM_CARD_MAX_ACTIONS=6
SONARAIM_CARD_SIGNATURE_ALGORITHM=Ed25519

# Passkey WebAuthn PRF & Zero-Knowledge Vault Parameters
SONARAIM_VAULT_HKDF_HASH=sha256
SONARAIM_VAULT_HKDF_INFO=sonaraim-zk-vault-v1
SONARAIM_VAULT_CIPHER_ALGO=aes-256-gcm
SONARAIM_VAULT_KEY_LENGTH=32
SONARAIM_VAULT_IV_LENGTH=12
SONARAIM_VAULT_SCRYPT_COST=16384
SONARAIM_VAULT_SCRYPT_BLOCK_SIZE=8
SONARAIM_VAULT_SCRYPT_PARALLELIZATION=1

# Instant Web / App Clip Runtime Server
SONARAIM_APP_HOST=0.0.0.0
SONARAIM_APP_PORT=8080
SONARAIM_LOG_LEVEL=INFO
