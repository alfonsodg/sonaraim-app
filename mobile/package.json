{
  "name": "@sonaraim/mobile",
  "version": "0.1.0",
  "description": "SonarAIM React Native Expo Mobile Application — Dual Inbox, Zero-HTML Declarative Cards, and LiveKit E2E Calling",
  "main": "App.js",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-av": "~14.0.7",
    "expo-image-picker": "~15.0.7",
    "expo-notifications": "~0.28.19",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "license": "Apache-2.0"
}
